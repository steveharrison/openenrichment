# Copy to .env.local (gitignored) and fill in. Both are optional — without them
# the merchant card still shows the place IDs, it just omits that map embed.

# Google Maps Embed API. This key ships to the browser in plain sight, so it
# must be a browser key restricted by HTTP referrer to this site's domain, with
# only the Maps Embed API enabled. Do NOT reuse an unrestricted server-side key.
VITE_GOOGLE_MAPS_EMBED_KEY=

# MapKit JS token — a JWT, not the .p8 key. Sign one with your Apple Maps key
# (see https://developer.apple.com/documentation/mapkitjs/creating-and-using-tokens-with-mapkit-js).
# The token is origin-scoped and expires; re-issue it before it lapses. A token
# minted for one origin won't work on another, so dev and production each
# need their own (Vite dev origin is http://localhost:5173).
VITE_MAPKIT_TOKEN=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Optional —
# when it is empty, no analytics script is loaded.
VITE_GA_MEASUREMENT_ID=
